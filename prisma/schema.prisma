generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  password           String
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  wallets            UserWallet[]
  walletTransactions WalletTransaction[]
  Wallet Wallet[]

  Transaction Calendar[]

  Calendar Calendar[] @relation("CalendarFinishedByUser")

  userCalendars Calendar[] @relation("CalendarUser")
}

model Wallet {
  id           Int                 @id @default(autoincrement())
  name         String
  description  String?
  createdById  Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  createdBy    User                @relation(fields: [createdById], references: [id])
  users        UserWallet[]
  transactions WalletTransaction[]

  Transaction Calendar[]
}

model UserWallet {
  userId    Int
  walletId  Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  wallet    Wallet    @relation(fields: [walletId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@id([userId, walletId])
}

model Category {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  transactions WalletTransaction[]

  Transaction Calendar[]
}

model WalletTransaction {
  id              Int               @id @default(autoincrement())
  description     String
  price           Float
  type            TransactionType
  status          TransactionStatus
  transactionDate DateTime
  walletId        Int
  userId          Int
  categoryId      Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt
  deletedAt       DateTime?
  category        Category          @relation(fields: [categoryId], references: [id])
  user            User              @relation(fields: [userId], references: [id])
  wallet          Wallet            @relation(fields: [walletId], references: [id])
}

model Calendar {
  id              Int               @id @default(autoincrement())
  description     String
  status          TransactionStatus
  startDate       DateTime
  endDate         DateTime?
  finishedByUserId Int?
  walletId        Int
  userId          Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?         @updatedAt
  deletedAt       DateTime?
  user            User?              @relation("CalendarUser", fields: [userId], references: [id])
  finishedByUser  User?              @relation("CalendarFinishedByUser", fields: [finishedByUserId], references: [id])
  wallet          Wallet            @relation(fields: [walletId], references: [id])

  User User[]

  Category Category[]
}

enum TransactionType {
  income
  outcome
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELED
}
